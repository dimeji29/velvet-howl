{
  "outputDirectory": "dist",
  "buildCommand": "node scripts/build.mjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/images/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/fonts/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/css/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/js/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
  ],
  "redirects": [
    {"source": "/gallary.html", "destination": "/gallery", "permanent": true},
    {"source": "/gallary", "destination": "/gallery", "permanent": true},
    {"source": "/term.html", "destination": "/terms", "permanent": true},
    {"source": "/term", "destination": "/terms", "permanent": true}
  ]
}
